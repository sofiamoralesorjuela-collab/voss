<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chatbot Accesible</title>
  <style>
    /* === ESTILOS GENERALES === */
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #b976e0;
    }
body {
      font-family: Arial, sans-serif;
      margin: 0;
      background-color: #b976e0; /* color de respaldo */
      background-image: url('voss.jpg'); /* ¡Solo el nombre del archivo! */
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      height: 100vh;
    }
    /* === BURBUJA FLOTANTE === */
    .chat-bubble {
      position: fixed;
      bottom: 20px;
      right: 20px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #570353;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      transition: background 0.3s;
      z-index: 1000;
    }

    .chat-bubble:hover {
      background: #f987ff; /* Contraste mayor al pasar el mouse */
    }

    /* === CONTENEDOR DEL CHATBOT (oculto inicialmente) === */
    .chat-container {
      position: fixed;
      bottom: 90px;
      right: 20px;
      width: 100%;
      max-width: 380px;
      height: 500px;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
      display: flex;
      flex-direction: column;
      opacity: 0;
      pointer-events: none;
      transform: translateY(20px);
      transition: opacity 0.3s ease, transform 0.3s ease;
      overflow: hidden;
    }

    /* Cuando está activo se muestra con animación */
    .chat-container.active {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    /* === CABECERA DEL CHATBOT === */
    .chat-header {
      background: #97018d;
      color: #fff;
      padding: 12px;
      text-align: center;
      font-size: 16px;
      font-weight: bold;
      position: relative;
    }

    /* Botón para cerrar el chat */
    .close-btn {
      position: absolute;
      right: 12px;
      top: 12px;
      background: transparent;
      border: none;
      color: #fff;
      font-size: 18px;
      cursor: pointer;
    }

    /* === ÁREA DE MENSAJES === */
    .messages {
      flex: 1;
      padding: 12px;
      overflow-y: auto;
      background: #f4f4f4;
    }

    .message {
      margin: 8px 0;
      padding: 10px;
      border-radius: 10px;
      max-width: 75%;
      font-size: 14px;
      line-height: 1.4;
    }

    .user {
      background-color: #d1e7ff;
      align-self: flex-end;
      margin-left: auto;
    }

    .bot {
      background-color: #e9ecef;
      align-self: flex-start;
      margin-right: auto;
    }

    /* === ÁREA DE INPUT === */
    .input-area {
      display: flex;
      border-top: 1px solid #ccc;
      background: #fff;
    }

    .input-area input {
      flex: 1;
      padding: 12px;
      border: none;
      outline: none;
      font-size: 14px;
    }

    .input-area button {
      padding: 12px 16px;
      background: #97018d;
      color: white;
      border: none;
      cursor: pointer;
      transition: background 0.3s;
    }

    .input-area button:hover {
      background: #f987ff;
    }

    /* === ACCESIBILIDAD Y RESPONSIVIDAD === */
    @media (max-width: 480px) {
      .chat-container {
        right: 10px;
        left: 10px;
        height: 70vh; /* altura dinámica para móviles */
      }
    }
  </style>
</head>
<body>
  <!-- BURBUJA FLOTANTE -->
  <button class="chat-bubble" id="chatToggle" aria-label="Abrir chat con el bot">💬</button>

  <!-- CONTENEDOR PRINCIPAL DEL CHAT -->
  <div class="chat-container" id="chatContainer" role="dialog" aria-modal="true" aria-labelledby="chatTitle">
    <!-- CABECERA -->
    <div class="chat-header">
      <span id="chatTitle"> chatboy de voss </span>
      <button class="close-btn" id="closeChat" aria-label="Cerrar chat">✖</button>
    </div>

    <!-- ÁREA DE MENSAJES -->
    <div class="messages" id="messages" role="log" aria-live="polite"></div>

    <!-- ÁREA DE INPUT -->
    <div class="input-area">
      <input type="text" id="userInput" aria-label="Escribe tu mensaje" placeholder="Escribe tu pregunta..." />
      <button id="sendBtn">Enviar</button>
    </div>
  </div>

  <script>
    // === REFERENCIAS A ELEMENTOS DEL DOM ===
    const chatToggle = document.getElementById("chatToggle");
    const chatContainer = document.getElementById("chatContainer");
    const closeChat = document.getElementById("closeChat");
    const messages = document.getElementById("messages");
    const userInput = document.getElementById("userInput");
    const sendBtn = document.getElementById("sendBtn");

    // Variables de estado
    let isChatOpen = false;
    let saludoInicial = false;

    /* === FUNCIÓN: agregar mensaje al área === */
    function addMessage(text, sender) {
      const div = document.createElement("div");
      div.classList.add("message", sender);
      div.textContent = text;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight; // siempre baja al último mensaje
    }

    /* === RESPUESTAS DEL BOT PARA VOSS BEACH === */
    function botResponse(input) {
      const pregunta = input.toLowerCase();
      if (pregunta.includes("vestidos") || pregunta.includes("baño")) {
        return "Ofrecemos hermosos vestidos de baño enteros y de dos piezas con diseños exclusivos de Voss Beach.";
      } else if (pregunta.includes("salidas") || pregunta.includes("pareos")) {
        return "Sí, contamos con salidas de baño ligeras ideales para complementar tu look en la playa.";
      } else if (pregunta.includes("tallas") || pregunta.includes("medidas")) {
        return "Puedes guiarte por nuestra guía de tallas o pedir asesoría personalizada con nosotros.";
      } else if (pregunta.includes("envios") || pregunta.includes("envíos")) {
        return "Realizamos envíos seguros a todo el país. ¿A qué ciudad necesitas que enviemos tu pedido?";
      } else if (pregunta.includes("personalizados") || pregunta.includes("diseño")) {
        return "¡Sí! Realizamos algunos detalles personalizados en nuestros vestidos y prendas de playa.";
      } else if (pregunta.includes("salir") || pregunta.includes("adios")) {
        return "¡Gracias por visitar Voss Beach! 🌊 Escríbenos si necesitas algo más.";
      } else {
        return "Lo siento, no entendí tu pregunta. Puedes preguntar por 'vestidos', 'salidas de baño', 'tallas' o 'envíos'.";
      }
    }

    /* === FUNCIÓN: enviar mensaje del usuario === */
    function sendMessage() {
      const text = userInput.value.trim();
      if (!text) return;

      addMessage(text, "user"); 
      userInput.value = ""; 
      userInput.focus();

      const respuesta = botResponse(text);
      setTimeout(() => addMessage(respuesta, "bot"), 400);
    }

    /* === EVENTOS === */

    // Abrir chatbot al hacer clic en la burbuja
    chatToggle.addEventListener("click", () => {
      isChatOpen = true;
      chatContainer.classList.add("active");
      chatToggle.style.display = "none"; // Oculta la burbuja
      
      // Muestra el mensaje de bienvenida una sola vez al abrir
      if (!saludoInicial) {
        addMessage('¡Hola! Bienvenido a Voss Beach 🌊. Puedes preguntar por "vestidos", "salidas de baño", "tallas" o "envíos".', 'bot');
        saludoInicial = true;
      }
      
      userInput.focus();
    });

    // Cerrar chatbot y mantener el historial
    closeChat.addEventListener("click", () => {
      isChatOpen = false;
      chatContainer.classList.remove("active");
      chatToggle.style.display = "flex"; // Vuelve a mostrar la burbuja
      chatToggle.focus();
    });

    // Botón enviar
    sendBtn.addEventListener("click", sendMessage);

    // Enviar con tecla Enter
    userInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") sendMessage();
    });
  </script>
</body>
</html>
